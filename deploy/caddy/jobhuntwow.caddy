# jhw:jobhuntwow BEGIN — managed by deploy_direct.py / CI.
# Edit THIS file and redeploy. NEVER hand-edit the droplet's Caddyfile: the deploy strips
# everything between the markers and re-appends this block, so a manual edit is lost.

# ONE canonical URL: https://jobhuntwow.com — and every other name we own is PROXIED HERE so the
# application can answer the redirect itself. A `redir` in this file is one line and works, and it
# also means the request never reaches the only process that writes an event: nobody who types the
# short domain would appear anywhere in our record, and "show me everyone trying to enter
# jobhw.org" could not be answered at all. backend/app/hosts.py issues the 301, in one hop, after
# the request has been observed with host=<what they typed>. The ACME challenge is never
# redirected (a bounced challenge is a certificate outage), which that module asserts.
www.jobhuntwow.com, jobhw.org, www.jobhw.org {
	log {
		output stdout
		format json
	}
	reverse_proxy jhw-web:8000 {
		header_up X-Client-Proto {http.request.proto}
	}
}

jobhuntwow.com {
	# JSON access log -> Caddy stdout -> videodead-promtail (docker_sd) -> Loki, labelled
	# container="videodead-caddy-1". This is what the "JobHuntWOW — traffic" Grafana dashboard
	# reads: {container="videodead-caddy-1"} | json | request_host="jobhuntwow.com". Without it
	# the dashboard is empty (no access logs for this host). 1:1 with cybergod.ai's traffic board.
	log {
		output stdout
		format json
	}
	encode zstd gzip
	# SPA + FastAPI are the same container. flush_interval -1 keeps SSE (chat) unbuffered.
	reverse_proxy jhw-web:8000 {
		flush_interval -1
		# WHOSE protocol version the app sees. Without this the app reads the PROXY-to-app hop
		# (always HTTP/1.1, because Caddy opens a fresh upstream connection), so a check built on
		# it fires on 100% of real browsers — a check that cannot fail, pointed the wrong way.
		# With it, `hvs="p"` and a Chrome 131 that spoke HTTP/1.1 to us is genuinely contradicting
		# itself. It also makes the HTTP/3 half of the browser probe measurable server-side.
		header_up X-Client-Proto {http.request.proto}
	}
}
# jhw:jobhuntwow END
