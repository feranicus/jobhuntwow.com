    {
      "type": "timeseries",
      "title": "OTP sends per minute, by result",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (count_over_time({job=~\".+\"} |= `\"service\": \"jhw-web\"` | json | evt=`otp_send` [1m]))",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "${DS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          },
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Auth events per minute, by result",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
